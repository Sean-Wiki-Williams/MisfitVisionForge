<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<SplitPane fx:id="mainPane" dividerPositions="0.5" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.visonforge.visionforge.VisionForgeController">
    <AnchorPane>
        <VBox fx:id="leftBox" alignment="CENTER" prefHeight="591.0" prefWidth="56.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Button fx:id="loadTrainingFolderButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" text="LOAD" textAlignment="CENTER" VBox.vgrow="ALWAYS">
                <VBox.margin>
                    <Insets />
                </VBox.margin>
            </Button>
         <HBox alignment="CENTER" spacing="10.0">
            <children>
                  <TableView fx:id="imageTable" prefWidth="210.0">
                      <columns>
                          <TableColumn fx:id="imageColumn" maxWidth="1.7976931348623157E308" minWidth="200.0" prefWidth="200.0" text="Filename" />
                      </columns>
                  </TableView>
                  <TableView fx:id="bboxTable" editable="true">
                      <columns>
                          <TableColumn fx:id="typeColumn" prefWidth="75.0" text="Type" />
                          <TableColumn prefWidth="75.0" text="X1" fx:id="x1Column" />
                          <TableColumn fx:id="y1Column" prefWidth="75.0" text="Y1" />
                          <TableColumn prefWidth="75.0" text="X2" fx:id="x2Column" />
                          <TableColumn fx:id="y2Column" prefWidth="75.0" text="Y2" />
                      </columns>
                  </TableView>
            </children>
         </HBox>
            <ComboBox fx:id="typeComboBox" prefWidth="150.0" />
            <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0">
                <children>
                    <Button fx:id="saveButton" alignment="CENTER" text="SAVE">
                        <HBox.margin>
                            <Insets right="10.0" />
                        </HBox.margin>
                    </Button>
                    <Button fx:id="updateButton" alignment="CENTER" mnemonicParsing="false" text="UPDATE">
                        <HBox.margin>
                            <Insets />
                        </HBox.margin>
                    </Button>
                    <Button fx:id="deleteButton" alignment="CENTER" mnemonicParsing="false" text="DELETE">
                        <HBox.margin>
                            <Insets left="10.0" />
                        </HBox.margin>
                    </Button>
                </children>
            </HBox>
            <BarChart fx:id="chart">
                <xAxis>
                    <CategoryAxis side="BOTTOM" />
                </xAxis>
                <yAxis>
                    <NumberAxis side="LEFT" />
                </yAxis>
            </BarChart>
        </VBox>
    </AnchorPane>
    <AnchorPane prefHeight="803.0" prefWidth="736.0">
        <children>
         <StackPane layoutX="-0.800000011920929" layoutY="-0.800000011920929" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                  <ScrollPane>
                      <content>
                          <StackPane id="drawingSurface" fx:id="drawingSurface" alignment="TOP_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" stylesheets="@style.css">
                              <children>
                                  <ImageView fx:id="trainingImage" fitHeight="2000.0" fitWidth="2000.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="TOP_LEFT">
                                      <cursor>
                                          <Cursor fx:constant="CROSSHAIR" />
                                      </cursor>
                                      <viewport>
                                          <Rectangle2D />
                                      </viewport>
                                  </ImageView>
                              </children>
                          </StackPane>
                      </content>
                  </ScrollPane>
               <Slider fx:id="zoomSlider" blockIncrement="0.1" max="1.5" maxHeight="-Infinity" min="0.1" minHeight="-Infinity" orientation="VERTICAL" value="0.25" StackPane.alignment="TOP_LEFT">
                  <StackPane.margin>
                     <Insets left="10.0" top="10.0" />
                  </StackPane.margin>
               </Slider>
            </children>
         </StackPane>
        </children>
    </AnchorPane>
</SplitPane>
